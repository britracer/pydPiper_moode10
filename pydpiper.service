[Unit]
Description=LCD server for music player

[Service]
# Command to execute when the service is started
# Wait port 6600 to be available
ExecStartPre=/bin/sh -c "while ! /bin/nc -z localhost 6600 ; do sleep 1 ; done"
ExecStart=/usr/bin/python3 -m app.pydPiper
WorkingDirectory=/home/pi/pydPiper
User=pi

[Install]
WantedBy = multi-user.target
